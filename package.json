{
  "name": "plugins-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the open-plugin installer CLI.",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "format": "prettier --write \"apps/**/*.ts\" \"*.{json,yaml}\"",
    "format:check": "turbo run format:check",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3",
    "turbo": "^2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "volta": {
    "node": "22.23.2"
  }
}
